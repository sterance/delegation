# Shared settings for the server and client. Copy to config.env (gitignored).
#
# Every key is optional; a missing key uses the default shown here. A real
# environment variable always overrides the file.
#
# Where the file is read from:
#   Docker   ../config.env relative to each compose file (i.e. the repo root),
#            passed in via env_file
#   Native   $DELEGATION_CONFIG if set, else ./config.env; the client also
#            checks ~/.config/delegation-client/config.env
#
# Durations are in milliseconds.

# SERVER
# Port inside the container / on the host. The compose port mapping, dev.sh
# and the Cloudflare Tunnel route all assume 7070; change them together.
SERVER_PORT=7070
SERVER_AUTH_TIMEOUT_MS=5000
SERVER_HEARTBEAT_TIMEOUT_MS=30000
SERVER_HEARTBEAT_SWEEP_INTERVAL_MS=10000
SERVER_PAIRING_CODE_TTL_MS=600000
# Native-run paths (the Docker image sets its own):
# DB_PATH=data/delegation.db
# FRONTEND_DIR=frontend/dist

# CLIENT
CLIENT_ACK_TIMEOUT_MS=30000
CLIENT_HEARTBEAT_INTERVAL_MS=10000
CLIENT_RECONNECT_INITIAL_BACKOFF_MS=1000
CLIENT_RECONNECT_MAX_BACKOFF_MS=30000
