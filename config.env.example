# Server settings. Copy to config.env (gitignored).
#
# Every key is optional; a missing or blank key uses the default shown here.
# A real environment variable always overrides the file. The server reads
# and checks everything once at startup: an invalid value (including a
# broken rule between two values) stops it with a message naming the key.
# Changes need a server restart.
#
# Clients have no config file of their own. The keys marked "pushed" are
# sent to each client when it connects, so after a restart clients pick them
# up as they reconnect. Each client caches the last set it received, for its
# reconnect backoff.
#
# Where the file is read from:
#   Docker   ../config.env relative to each compose file (i.e. the repo root),
#            passed in via env_file
#   Native   $DELEGATION_CONFIG if set, else ./config.env
#
# Durations are in milliseconds unless the name says otherwise.

# SERVER
# Port inside the container / on the host. The dev compose port mapping, dev.sh
# and the deploy workflow (port: in .github/workflows/deploy.yml) all assume 7070;
# change them together.
SERVER_PORT=7070
# How long a connecting client has for each step of the handshake.
SERVER_AUTH_TIMEOUT_MS=5000
# info, or debug for a line per tick and per sample.
SERVER_LOG_LEVEL=info
# Native-run paths (the Docker image sets its own):
# DB_PATH=data/delegation.db
# FRONTEND_DIR=frontend/dist
# Before upgrading the database schema, the server writes a backup next to the
# database (delegation.db.pre-v<version>-<UTC time>.bak). It keeps this many of the
# newest and deletes older ones. At least 1. Restoring one: server/DATABASE.md.
DB_MIGRATION_BACKUPS_KEEP=3

# TICK AND LIVENESS
# Pushed. How often each client sends a tick (its metrics and its liveness signal).
TICK_INTERVAL_MS=1000
# Pushed. How often the client's sampler takes a reading. At least 200 (CPU % needs readings that far apart).
SAMPLER_INTERVAL_MS=500
# Pushed. A tick carries no metrics if the newest reading is older than this. At least 2 x SAMPLER_INTERVAL_MS.
SAMPLE_MAX_AGE_MS=3000
# The server drops a client it hasn't heard anything from for this long. At least 2 x TICK_INTERVAL_MS.
LIVENESS_TIMEOUT_MS=4000
# How often the server pings each client, so clients can tell it's still there.
WS_PING_INTERVAL_MS=2000
# Pushed. A client reconnects if it hears nothing from the server for this long. At least 2 x WS_PING_INTERVAL_MS.
SERVER_SILENCE_TIMEOUT_MS=6000
# Pushed (and cached by clients). First reconnect delay; doubles on each failure.
RECONNECT_BACKOFF_INITIAL_MS=1000
# Pushed (and cached by clients). Reconnect delay cap. At least RECONNECT_BACKOFF_INITIAL_MS.
RECONNECT_BACKOFF_MAX_MS=30000
# How often changed last_seen_at values are written to SQLite (also on disconnect and shutdown).
LAST_SEEN_FLUSH_INTERVAL_MS=30000

# METRICS
# Samples kept in memory per client; also each graph's width in samples. At least 2.
METRICS_HISTORY_SAMPLES=60
# Samples arriving closer together than this are dropped. Less than TICK_INTERVAL_MS; 0 turns it off.
METRICS_MIN_SPACING_MS=500
# Samples listing more GPUs than this are dropped.
METRICS_MAX_GPUS=16
# Samples with a longer string (a GPU name) are dropped.
METRICS_MAX_STRING_LEN=128

# PAIRING
# How long a pairing code from the Add Client dialog stays valid, in seconds.
PAIRING_CODE_TTL_SECS=600
# How often the Add Client dialog checks whether its code has been used.
DASHBOARD_PAIRING_POLL_INTERVAL_MS=1500

# CHAT
# How long a chat reply may go without the client sending any of it (including the first
# piece) before the server marks it failed and tells the client to stop. Allow for a model loading.
CHAT_IDLE_TIMEOUT_MS=120000
# How often a streaming reply's text so far is written to the database (and again when it ends).
CHAT_FLUSH_INTERVAL_MS=3000
# Delete conversations not updated for this many days, checked daily. 0 keeps them forever.
CHAT_RETENTION_DAYS=0
# Longest message a user can send, in characters.
CHAT_MAX_MESSAGE_CHARS=100000
# A reply that grows past this many characters is stopped and marked failed, so a runaway
# client can't fill the database.
CHAT_MAX_REPLY_CHARS=400000
# Replies one user can have generating at once (and one per conversation, always).
CHAT_MAX_ACTIVE_REPLIES_PER_USER=3

# INFERENCE
# Clients run models with llama.cpp: a pinned llama-server release they download (and
# check by hash) the first time a model is installed. Models are installed from the
# dashboard (a client card's Models section). All of these are pushed.
# How often clients report download progress. At least 100.
INFERENCE_PROGRESS_INTERVAL_MS=1000
# Clients stop llama-server after this many seconds without a request, giving the memory
# back to the volunteer. The next request loads the model again. 0 never unloads.
INFERENCE_IDLE_UNLOAD_SECS=600
# How long a client waits for a model to load. While it loads, the client keeps telling the
# server it's alive, so CHAT_IDLE_TIMEOUT_MS doesn't cut the reply off. At least 1000.
INFERENCE_MODEL_LOAD_TIMEOUT_MS=120000
# Replies a client generates at once (llama-server slots, each with the model's full
# context). More requests than this fail with "client busy". 1 to 64.
INFERENCE_MAX_CONCURRENT=1
# The longest reply, in tokens. Less than INFERENCE_DEFAULT_CONTEXT and TEST_MODEL_CONTEXT:
# the server trims a conversation's oldest turns so the prompt fits in the model's context
# minus this, always keeping the newest message.
INFERENCE_MAX_TOKENS=2048
# Context size, in tokens, for a model that doesn't specify one. At least 256.
INFERENCE_DEFAULT_CONTEXT=4096
# CPU threads for llama.cpp. 0 lets it decide.
INFERENCE_THREADS=0
# A download is refused up front unless this much disk stays free on the client afterwards.
INFERENCE_DISK_RESERVE_MB=2048
# true: clients offer the built-in "echo" test model, which replies with your message, for
# testing chat without a real model. It shows in the chat model picker and on client cards
# (Models section); false hides it everywhere.
INFERENCE_ECHO_MODEL=false

# TEST MODEL
# The one model the dashboard can install for now (the catalog). Browsers only ever send
# its id; the URL and hash stay here. A download whose size or SHA-256 differs is deleted.
# Qwen2.5 0.5B Instruct, Q4_K_M quantization, Apache-2.0, from Qwen's own repository.
TEST_MODEL_ID=qwen2.5-0.5b-instruct-q4_k_m
TEST_MODEL_NAME=Qwen2.5 0.5B Instruct (Q4_K_M)
# HTTPS only.
TEST_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf
# The file's Git LFS object id on Hugging Face is its SHA-256.
TEST_MODEL_SHA256=74a4da8c9fdbcd15bd1f6d01d621410d31c6fc00986f5eb687824e7b93d7a9db
TEST_MODEL_SIZE_BYTES=491400032
# Context length to run it with, in tokens.
TEST_MODEL_CONTEXT=4096

# HTTP AND SECURITY
# The site's origin, as browsers see it: scheme://host[:port], no path. Every request that
# changes something must carry a matching Origin header (CSRF protection). Also used to
# build password reset links and the setup instructions in the log.
PUBLIC_ORIGIN=https://llm.smith-c.com
# Comma-separated extra origins accepted by that check, for local development, e.g.
# http://localhost:5173 for the Vite dev server. dev/docker-compose.yml sets its own.
EXTRA_ALLOWED_ORIGINS=
# Mark the session cookie Secure (and name it __Host-delegation_session), and send
# Strict-Transport-Security. Must be false for plain-http deployments; the dev compose
# file sets false.
COOKIE_SECURE=true
# Use Cloudflare's CF-Connecting-IP header as the client's address for rate limits. ONLY
# safe when every request reaches the server through Cloudflare (port 7070 isn't
# published, and nothing else that could send it requests sets the header); otherwise
# anyone can forge the header and dodge the limits. false uses the TCP peer address.
TRUST_CF_CONNECTING_IP=true
# Running the server natively for development (cargo run, http://127.0.0.1:7070)? Use:
#   PUBLIC_ORIGIN=http://127.0.0.1:7070
#   EXTRA_ALLOWED_ORIGINS=http://localhost:7070,http://localhost:5173
#   COOKIE_SECURE=false
#   TRUST_CF_CONNECTING_IP=false

# AUTH
# true: anyone can create an account on the login page. false: only "Log in" is offered,
# and accounts exist only if they already do. Sign-up is always refused until the admin
# has been created at /setup.
AUTH_SIGNUP_ENABLED=true
# Accounts one IP can create per AUTH_SIGNUP_WINDOW_SECS.
AUTH_SIGNUP_MAX_PER_IP=5
AUTH_SIGNUP_WINDOW_SECS=3600
# Password length, in characters. No composition rules.
AUTH_PASSWORD_MIN_LEN=12
# The maximum bounds the cost of hashing. At least AUTH_PASSWORD_MIN_LEN.
AUTH_PASSWORD_MAX_LEN=256
# Argon2id cost. Raising them rehashes each user's password with the new values the next
# time they log in. Memory must be at least 8 x parallelism.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
# Failed logins allowed per username+IP, and per IP across usernames, within
# AUTH_LOGIN_WINDOW_SECS. The next attempt gets 429 with Retry-After.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_MAX_FAILURES_PER_IP=20
AUTH_LOGIN_WINDOW_SECS=900
# /enroll attempts (pairing codes) allowed per IP within AUTH_LOGIN_WINDOW_SECS.
ENROLL_MAX_ATTEMPTS_PER_IP=10
# A session nobody has used for this long expires.
SESSION_IDLE_TIMEOUT_HOURS=168
# How long a "Remember me" session (and its cookie) lasts after login, however much it's used.
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
# How long a session without "Remember me" lasts after login. Its cookie ends with the browser.
SESSION_SHORT_TIMEOUT_HOURS=12
# Update a session's last-used time in the database at most this often (the dashboard
# polls every second, and doesn't need a write each time).
SESSION_TOUCH_INTERVAL_SECS=300
# How long a password reset link made on the Users page stays valid.
PASSWORD_RESET_TTL_HOURS=24

# DASHBOARD
# How often the dashboard polls the client list.
DASHBOARD_POLL_INTERVAL_MS=1000
# true: stop polling while the browser tab is hidden, and poll at once when it's shown again.
DASHBOARD_PAUSE_WHEN_HIDDEN=true
# Usage graph width, in pixels.
DASHBOARD_GRAPH_WIDTH_PX=120
# Usage graph height, in pixels.
DASHBOARD_GRAPH_HEIGHT_PX=40
# Usage graph grid cell size, in pixels.
DASHBOARD_GRAPH_GRID_PX=10
# Usage line colour, #rgb or #rrggbb. Leave it unquoted: docker run --env-file keeps quotes.
DASHBOARD_GRAPH_LINE_COLOR=#00ff00
# Grid line colour.
DASHBOARD_GRAPH_GRID_COLOR=#008040
# Graph background.
DASHBOARD_GRAPH_BG_COLOR=#000000
# How many GPUs get graphs in a collapsed client card; the rest show when it's expanded. 0 for none.
DASHBOARD_COLLAPSED_MAX_GPUS=1
# One full cycle of the blue dot next to each client's status dot (bright, dim, bright again).
# It blinks only while the client is working on a job (a chat reply), and is steady dim blue otherwise.
DASHBOARD_BLINK_PERIOD_MS=1000
