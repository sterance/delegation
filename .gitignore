# Rust build output (workspace root and any stray per-crate target dirs)
target/

# Node (legacy server, kept in case of leftovers)
node_modules/
dist/

# Local runtime data (SQLite DB defaults to data/delegation.db)
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment / local config (config.env.example is committed)
.env
config.env

# Local docker overrides
docker-compose.override.yml

# deploy.sh state (server/.deploy-previous, server/.deploy.lock)
.deploy-previous
.deploy.lock

# Logs
*.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
dev/.native-home/
